*.txt
corpus/
corpora/
data/
datasets/
!requirements.txt

# ── Notebook output ───────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb_checkpoints
.ipynb_output/
# Strips cell outputs on commit, which keeps diffs readable and the repo small.
# Remove the `#` below if you want the notebook's saved outputs published.
